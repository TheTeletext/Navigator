#let version = "1.6"

#import "lib.typ": *
#set document(title: "Teletext Navigator User's Guide", author: "The Teletext")
#set text(font: serif, size: 10.5pt, lang: "en", hyphenate: true)
#set par(justify: true, leading: 0.62em, spacing: 0.95em)
#set list(indent: 0.6em, body-indent: 0.5em, marker: [•])
#set enum(indent: 0.6em, body-indent: 0.5em, numbering: "1.")
#show raw: set text(font: mono, size: 9.5pt)

#import "lib.typ": *
#show figure.caption: it => [#text(font: sans, size: 9pt, weight: "bold")[Figure #it.counter.display()] #h(0.4em) #it.body]
#show figure: set block(breakable: false, above: 1.4em, below: 1.4em)

// ---------------------------------------------------------------- headings
#set heading(numbering: (..n) => if n.pos().len() == 1 { str(n.pos().first()) })
#show heading.where(level: 1): it => {
  pagebreak(weak: true)
  v(0.9in)
  context {
    if it.numbering != none and numbered.get() {
      text(font: sans, size: 10pt, weight: "bold", tracking: 2pt, fill: navy, "CHAPTER " + counter(heading).display())
      v(0.3em)
    }
    grid(columns: (auto, 1fr), gutter: 0.8em, align: horizon,
      if chapicon.get() != none { image("build/" + chapicon.get().replace(".BMP", ".png"), width: 0.45in, scaling: "pixelated") },
      text(font: sans, size: 24pt, weight: "bold", it.body))
  }
  v(0.2em)
  line(length: 100%, stroke: 2.2pt + navy)
  v(0.5in)
}
#show heading.where(level: 2): it => {
  v(1.0em)
  block(below: 0.7em, text(font: sans, size: 13.5pt, weight: "bold", it.body))
}
#show heading.where(level: 3): it => block(above: 1.1em, below: 0.5em, text(font: sans, size: 10.5pt, weight: "bold", it.body))

// running head (not on chapter openers) and the page number outside
#let runninghead = context {
  let p = here().page()
  if query(heading.where(level: 1)).any(h => h.location().page() == p) { return }
  let hs = query(selector(heading.where(level: 1)).before(here()))
  if hs.len() == 0 { return }
  let t = hs.last().body
  set text(font: sans, size: 8.5pt)
  if calc.even(p) { [Teletext Navigator User's Guide #h(1fr) #emph(t)] } else { [#emph(t) #h(1fr) Teletext Navigator User's Guide] }
  v(-0.5em); line(length: 100%, stroke: 0.4pt)
}
#let foot = context {
  let p = here().page()
  set text(font: sans, size: 9pt)
  let n = counter(page).display()
  if calc.even(p) { [#n #h(1fr)] } else { [#h(1fr) #n] }
}

// ---------------------------------------------------------------- title page
#set page(paper: "us-letter", margin: (inside: 1.1in, outside: 0.9in, top: 1in, bottom: 0.9in), numbering: none, header: none, footer: none)
#block(width: 100%, height: 100%, {
  v(0.6in)
  line(length: 100%, stroke: 6pt + navy)
  v(0.25in)
  grid(columns: (auto, 1fr), gutter: 0.3in, align: horizon,
    image("../assets/brand/teletext-mark-256.png", width: 1.3in),
    [#text(font: sans, size: 38pt, weight: "bold")[Teletext Navigator] \
     #v(0.1em) #text(font: sans, size: 20pt)[User's Guide]])
  v(0.25in)
  line(length: 100%, stroke: 1.5pt + navy)
  v(0.15in)
  text(font: sans, size: 13pt)[Version #version]
  v(1fr)
  text(font: sans, size: 11pt)[For Microsoft Windows 10 and Windows 11 \ 64-bit (x64)]
  v(0.4in)
  line(length: 100%, stroke: 0.6pt)
  v(0.1in)
  text(font: sans, size: 16pt, weight: "bold")[The Teletext]
})

