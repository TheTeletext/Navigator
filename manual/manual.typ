// ---------------------------------------------------------------- front matter
#set page(numbering: "i", header: runninghead, footer: foot)
#counter(page).update(1)
#numbered.update(false)
#set heading(numbering: none)
#include "build/front.typ"

#show outline.entry.where(level: 1): it => { v(0.7em); strong(text(font: sans, it)) }
#outline(title: [Contents], depth: 2, indent: 1.4em)

// ---------------------------------------------------------------- the chapters
#set page(numbering: "1")
#counter(page).update(1)
#numbered.update(true)
#set heading(numbering: (..n) => if n.pos().len() == 1 { str(n.pos().first()) })
#counter(heading).update(0)
#include "build/body.typ"

// ---------------------------------------------------------------- index
#numbered.update(false)
#chapicon.update(none)
#heading(level: 1, numbering: none)[Index]
#set text(size: 9.5pt)
#columns(2, gutter: 0.35in, context {
  let entries = query(<idx>)
  let d = (:)
  for e in entries {
    let key = e.value
    let pg = numbering(e.location().page-numbering() + "", ..counter(page).at(e.location()))
    let lst = d.at(key, default: ())
    if pg not in lst { lst.push(pg) }
    d.insert(key, lst)
  }
  let keys = d.keys().sorted(key: k => lower(k))
  let letter = ""
  for k in keys {
    let l = upper(k.first())
    if l != letter {
      letter = l
      block(above: 1em, below: 0.4em, text(font: sans, weight: "bold", size: 11pt, l))
    }
    block(spacing: 0.3em, inset: (left: 0.8em), par(hanging-indent: 0.8em, justify: false, [#k, #d.at(k).join(", ")]))
  }
})
