/*
 * suite.rc - Application icon, embedded fonts, and version info.
 *
 * Part of Teletext Navigator.
 * The icon resource (ID 1) is loaded by suite_shell.c via MAKEINTRESOURCE(1).
 * Numeric IDs for the embedded font blobs are in suite_res.h.
 */

#include <winver.h>
#include "suite_res.h"

/* The version lives in exactly one place. windres runs the C
 * preprocessor over this file and concatenates adjacent string
 * literals, so the composed macros arrive as single strings. */
#include "suite_version.h"

/* Application icon (ID 1, loaded via MAKEINTRESOURCE(1)). The Teletext
 * monogram, 16 to 256 px with alpha, generated by
 * assets/brand/make_icon.sh from assets/brand/teletext-monogram.png.
 * windres resolves the path relative to this .rc file in src/. */
1 ICON "../assets/brand/teletext_navigator.ico"

/* Ubuntu Mono Regular and Bold, embedded as RCDATA. Loaded at startup
 * by suite_fonts_init via AddFontMemResourceEx, which makes them
 * process-private without writing to %WINDIR%\Fonts. Distributed under
 * the Ubuntu Font Licence 1.0 (see src/fonts/COPYING.UbuntuFontLicense.txt). */
100 RCDATA "fonts/UbuntuMono-Regular.ttf"
101 RCDATA "fonts/UbuntuMono-Bold.ttf"

/* The Teletext mark (256 px PNG, alpha intact), drawn in grayscale on
 * the CU-SeeMe Start screen by suite_logo.c. Resource IDs 200, 201 and
 * 300-306 are not embedded in Navigator. */
210 RCDATA "../assets/brand/teletext-mark-256.png"

/* GW-BASIC tab: the interpreter (MIT; see firmware/gwbasic/LICENSE and
 * MGT-BUILD.md) and the two listings printed in the Gazette. */
400 RCDATA "../firmware/gwbasic/GWBASICA.EXE"
401 RCDATA "../assets/basic/RETRO649.BAS"
402 RCDATA "../assets/basic/DIALUP.BAS"

/* Navigator 1.5: the Windows 3.1 ribbon and launcher icons, 32x32 in
 * the 16-colour VGA palette, drawn by tools/make_w31_icons.py. */
500 BITMAP "../assets/w31icons/home.bmp"
501 BITMAP "../assets/w31icons/ripscrip.bmp"
502 BITMAP "../assets/w31icons/nabu.bmp"
503 BITMAP "../assets/w31icons/videotex.bmp"
504 BITMAP "../assets/w31icons/web.bmp"
505 BITMAP "../assets/w31icons/gopher.bmp"
506 BITMAP "../assets/w31icons/arpanet.bmp"
507 BITMAP "../assets/w31icons/wais.bmp"
508 BITMAP "../assets/w31icons/archie.bmp"
509 BITMAP "../assets/w31icons/irc.bmp"
510 BITMAP "../assets/w31icons/cuseeme.bmp"
511 BITMAP "../assets/w31icons/terminal.bmp"
512 BITMAP "../assets/w31icons/gwbasic.bmp"
513 BITMAP "../assets/w31icons/ftp.bmp"
514 BITMAP "../assets/w31icons/newsgroups.bmp"
520 BITMAP "../assets/cusmicons/testpattern.bmp"   /* IDB_CUSM_TESTPATTERN */
530 BITMAP "../assets/w31icons/gt_menu.bmp"
531 BITMAP "../assets/w31icons/gt_text.bmp"
532 BITMAP "../assets/w31icons/gt_search.bmp"
533 BITMAP "../assets/w31icons/gt_telnet.bmp"
534 BITMAP "../assets/w31icons/gt_image.bmp"
535 BITMAP "../assets/w31icons/gt_video.bmp"
536 BITMAP "../assets/w31icons/gt_binary.bmp"
537 BITMAP "../assets/w31icons/gt_sound.bmp"
538 BITMAP "../assets/w31icons/gt_unknown.bmp"
539 BITMAP "../assets/w31icons/gt_link.bmp"

1 VERSIONINFO
FILEVERSION    SUITE_VERSION_MAJOR, SUITE_VERSION_MINOR, SUITE_VERSION_PATCH, SUITE_VERSION_BUILD
PRODUCTVERSION SUITE_VERSION_MAJOR, SUITE_VERSION_MINOR, SUITE_VERSION_PATCH, SUITE_VERSION_BUILD
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      SUITE_PUBLISHER
            VALUE "FileDescription",  SUITE_APP_NAME
            VALUE "FileVersion",      SUITE_VERSION_MSI "." SUITE_VER_STR_(SUITE_VERSION_BUILD)
            VALUE "InternalName",     "TeletextNavigator"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Dimitri Papadopoulos and The Teletext"
            VALUE "OriginalFilename", "TeletextNavigator.exe"
            VALUE "ProductName",      SUITE_APP_NAME
            VALUE "ProductVersion",   SUITE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
